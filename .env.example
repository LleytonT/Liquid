# Asks on Vercel use the deployment OIDC token. This key is only for a local gateway call.
# If the call fails, the ask falls back to the game's word list.
AI_GATEWAY_API_KEY=

# Upstash Redis from the Vercel Marketplace. When both are set, branches and traces
# are stored there. When UPSTASH_REDIS_REST_URL is missing, Liquid uses a file store
# and logs that on Vercel, because that disk does not last.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional path for the file store. Defaults to data/branches.json locally
# and /tmp/liquid-branches.json on Vercel.
# LIQUID_BRANCH_FILE=
